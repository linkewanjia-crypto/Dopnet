cff-version: 1.2.0
message: "Please cite DOP-Net software version 1.0.0 by Xipeng Huang and the accompanying DOP-Net work. The separate companion dataset DOI is linked in the repository README."
type: software
title: "DOP-Net: A Doppler Observation-Preserving Network for Doubly Selective MIMO-OFDM Channel Estimation"
authors:
  - family-names: Huang
    given-names: Xipeng
version: 1.0.0
repository-code: "https://github.com/linkewanjia-crypto/Dopnet"
